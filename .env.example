# Copiar este archivo como .env SOLO en una instalación nueva.
# Reemplazar los valores vacíos por dos claves aleatorias diferentes.
# No publicar el archivo .env ni sus valores.

# Clave utilizada por Open WebUI para firmar sesiones.
# Mantenerla estable en una instalación existente.
WEBUI_SECRET_KEY=

# Clave de autenticación de Open Terminal.
# Configurar la misma clave en su conexión dentro de Open WebUI.
OPEN_TERMINAL_API_KEY=